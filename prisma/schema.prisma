// Tables and columns are snake_case in Postgres and camelCase in the client,
// matching the JSON shapes in the frontend's lib/tracker/types.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Explicit, so generation doesn't depend on whether tsconfig.json is present (e.g. in Docker).
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A private team space: its own members, invites and projects. Users join through memberships.
model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  /// ^[a-z0-9]+(-[a-z0-9]+)*$, used in URLs; set at creation and unchanged by renames.
  slug      String   @unique
  /// The seeded Acme Inc workspace, whose demo passwords are public; some admin actions are locked.
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  projects     Project[]
  accessTokens AccessToken[]

  @@map("workspaces")
}

/// viewer = read-only · member = edit issues and sprints · admin = also members, workflow, project delete
enum Role {
  admin
  member
  viewer
}

/// A user's place in a workspace. Roles live here, so one person can be admin in one workspace and viewer in another.
model WorkspaceMember {
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        Role
  /// When they joined; orders the members list.
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([workspaceId, createdAt, userId])
  @@index([userId])
  @@map("workspace_members")
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-case.
  email           String    @unique
  name            String
  handle          String    @unique
  /// Tailwind gradient classes for the initials avatar (frontend AVATAR_GRADIENTS).
  gradient        String
  timezone        String    @default("UTC")
  bio             String    @default("")
  /// Argon2id. Null for accounts that only sign in with OAuth.
  passwordHash    String?   @map("password_hash")
  /// Null until the owner proves the address (an emailed link, an OAuth provider or an accepted invite).
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  lastActiveAt    DateTime? @map("last_active_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         WorkspaceMember[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts       OAuthAccount[]
  accessTokens        AccessToken[]
  invitesSent         WorkspaceInvite[]    @relation("InvitesSent")
  projectsLed         Project[]            @relation("ProjectLead")
  assignedIssues      Issue[]              @relation("IssueAssignee")
  comments            IssueComment[]

  @@map("users")
}

/// One sign-in: a family of rotating refresh tokens. Revoking it signs that device out.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Absolute lifetime; refreshing does not extend it.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the token; the token itself is only ever in the client's cookie.
  tokenHash String    @unique @map("token_hash")
  /// Set when rotated. Presenting a used token again revokes the whole session.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Single-use, short-lived link sent by email to set a new password.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum OAuthProvider {
  github
  google
}

/// A GitHub or Google identity linked to a user; one user can link both.
model OAuthAccount {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Personal access token for the CLI and scripts: `Authorization: Bearer dfp_…`. Works in one workspace only.
model AccessToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  /// SHA-256 of the secret, which is shown to the user once and never stored.
  tokenHash   String    @unique @map("token_hash")
  lastFour    String    @map("last_four")
  /// issues:read, issues:write, projects:admin, webhooks:manage
  scopes      String[]
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId])
  @@map("access_tokens")
}

/// A pending invitation; deleted when accepted, so one row per invited email.
model WorkspaceInvite {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Always stored lower-case.
  email       String
  role        Role
  /// SHA-256 of the emailed token; rotated on every resend.
  tokenHash   String   @unique @map("token_hash")
  invitedById String?  @map("invited_by_id") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt, id])
  @@map("workspace_invites")
}

/// Categories give custom statuses shared meaning (e.g. what counts as done).
enum StatusCategory {
  todo
  in_progress
  done
}

model Project {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  /// ^[A-Z]{2,5}$, immutable; issues are keyed KEY-n.
  key             String
  name            String
  description     String   @default("")
  /// Tailwind gradient classes for the project icon.
  color           String
  leadId          String?  @map("lead_id") @db.Uuid
  /// Next issue number; incremented atomically when an issue is created.
  nextIssueNumber Int      @default(1) @map("next_issue_number")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      User?            @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  statuses  WorkflowStatus[]
  sprints   Sprint[]
  issues    Issue[]

  @@unique([workspaceId, key])
  @@map("projects")
}

/// A board column. `position` orders the workflow left to right.
model WorkflowStatus {
  id        String         @id @default(uuid(7)) @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  name      String
  category  StatusCategory
  position  Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId, position])
  @@map("workflow_statuses")
}

enum SprintStatus {
  planned
  active
  completed
}

/// planned → active (one per project) → completed. Lifecycle endpoints arrive in v0.5.0.
model Sprint {
  id                      String       @id @default(uuid(7)) @db.Uuid
  projectId               String       @map("project_id") @db.Uuid
  number                  Int
  name                    String
  goal                    String       @default("")
  status                  SprintStatus @default(planned)
  startAt                 DateTime?    @map("start_at") @db.Timestamptz(3)
  endAt                   DateTime?    @map("end_at") @db.Timestamptz(3)
  /// Points in the sprint when it started.
  committedPoints         Int?         @map("committed_points")
  completedAt             DateTime?    @map("completed_at") @db.Timestamptz(3)
  /// The report written when the sprint completes; all four are null until then.
  reportCommittedPoints   Int?         @map("report_committed_points")
  reportCompletedPoints   Int?         @map("report_completed_points")
  reportCompletedIssues   Int?         @map("report_completed_issues")
  reportCarriedOverIssues Int?         @map("report_carried_over_issues")
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@unique([projectId, number])
  @@map("sprints")
}

enum IssueType {
  story
  bug
  task
}

enum Priority {
  urgent
  high
  medium
  low
}

model Issue {
  id           String    @id @default(uuid(7)) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  /// The n in KEY-n, unique per project.
  number       Int
  /// Null = in the backlog.
  sprintId     String?   @map("sprint_id") @db.Uuid
  statusId     String    @map("status_id") @db.Uuid
  type         IssueType
  priority     Priority
  title        String
  description  String    @default("")
  assigneeId   String?   @map("assignee_id") @db.Uuid
  tags         String[]  @default([])
  /// Linked pull request or commit ({ kind: "pr", number, state } | { kind: "commit", sha }); set by GitHub webhooks.
  git          Json?
  /// Story points: 1, 2, 3, 5, 8, 13 or null.
  estimate     Int?
  commentCount Int       @default(0) @map("comment_count")
  /// Fractional index; compared byte-wise (the migration sets COLLATE "C").
  rank         String
  dueAt        DateTime? @map("due_at") @db.Timestamptz(3)
  /// Set when the issue enters a done-category status, cleared when it leaves.
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint   Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  status   WorkflowStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignee User?          @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events   IssueEvent[]
  comments IssueComment[]

  @@unique([projectId, number])
  @@index([projectId, rank, id])
  @@index([sprintId])
  @@map("issues")
}

enum IssueEventKind {
  created
  status
  sprint
  estimate
}

/// History of the changes that matter for burndown, recording the issue's state after each change.
model IssueEvent {
  id        String         @id @default(uuid(7)) @db.Uuid
  issueId   String         @map("issue_id") @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  kind      IssueEventKind
  actorId   String?        @map("actor_id") @db.Uuid
  sprintId  String?        @map("sprint_id") @db.Uuid
  statusId  String         @map("status_id") @db.Uuid
  estimate  Int?
  done      Boolean
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@index([projectId, createdAt])
  @@map("issue_events")
}

/// Markdown text; the frontend sanitises it when rendering.
model IssueComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  issueId   String   @map("issue_id") @db.Uuid
  /// Null once the author has been removed from the workspace.
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt, id])
  @@map("issue_comments")
}
