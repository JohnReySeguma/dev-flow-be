// Tables and columns are snake_case in Postgres and camelCase in the client,
// matching the JSON shapes in the frontend's lib/tracker/types.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Explicit, so generation doesn't depend on whether tsconfig.json is present (e.g. in Docker).
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// The single tenant every user belongs to. Multiple workspaces are out of scope.
model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users    User[]
  invites  WorkspaceInvite[]
  projects Project[]

  @@map("workspaces")
}

/// viewer = read-only · member = edit issues and sprints · admin = also members, workflow, project delete
enum Role {
  admin
  member
  viewer
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  /// Always stored lower-case.
  email        String    @unique
  name         String
  handle       String    @unique
  /// Tailwind gradient classes for the initials avatar (frontend AVATAR_GRADIENTS).
  gradient     String
  timezone     String    @default("UTC")
  bio          String    @default("")
  role         Role      @default(member)
  /// Argon2id. Null for accounts that only sign in with OAuth.
  passwordHash String?   @map("password_hash")
  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts       OAuthAccount[]
  accessTokens        AccessToken[]
  invitesSent         WorkspaceInvite[]    @relation("InvitesSent")
  projectsLed         Project[]            @relation("ProjectLead")

  @@index([workspaceId])
  @@map("users")
}

/// One sign-in: a family of rotating refresh tokens. Revoking it signs that device out.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Absolute lifetime; refreshing does not extend it.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the token; the token itself is only ever in the client's cookie.
  tokenHash String    @unique @map("token_hash")
  /// Set when rotated. Presenting a used token again revokes the whole session.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Single-use, short-lived link sent by email to set a new password.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum OAuthProvider {
  github
  google
}

/// A GitHub or Google identity linked to a user; one user can link both.
model OAuthAccount {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Personal access token for the CLI and scripts: `Authorization: Bearer dfp_…`.
model AccessToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  /// SHA-256 of the secret, which is shown to the user once and never stored.
  tokenHash  String    @unique @map("token_hash")
  lastFour   String    @map("last_four")
  /// issues:read, issues:write, projects:admin, webhooks:manage
  scopes     String[]
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("access_tokens")
}

/// A pending invitation; deleted when accepted, so one row per invited email.
model WorkspaceInvite {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Always stored lower-case.
  email       String
  role        Role
  /// SHA-256 of the emailed token; rotated on every resend.
  tokenHash   String   @unique @map("token_hash")
  invitedById String?  @map("invited_by_id") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt, id])
  @@map("workspace_invites")
}

/// Categories give custom statuses shared meaning (e.g. what counts as done).
enum StatusCategory {
  todo
  in_progress
  done
}

model Project {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  /// ^[A-Z]{2,5}$, immutable; issues are keyed KEY-n.
  key             String
  name            String
  description     String   @default("")
  /// Tailwind gradient classes for the project icon.
  color           String
  leadId          String?  @map("lead_id") @db.Uuid
  /// Next issue number; incremented atomically when an issue is created.
  nextIssueNumber Int      @default(1) @map("next_issue_number")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      User?            @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  statuses  WorkflowStatus[]

  @@unique([workspaceId, key])
  @@map("projects")
}

/// A board column. `position` orders the workflow left to right.
model WorkflowStatus {
  id        String         @id @default(uuid(7)) @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  name      String
  category  StatusCategory
  position  Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("workflow_statuses")
}
