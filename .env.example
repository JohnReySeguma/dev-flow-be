# Copy to .env and fill in. Never commit .env or any *.pem file.
# Optional integrations are disabled automatically when their values are empty.

# ── Server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Long random strings, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SEED_DEMO_DATA=true

# ── Database (required) ─────────────────────────────────────────────
# Postgres runs in Docker: `npm run db:up` (Docker Desktop must be running).
# These localhost URLs are for `npm run dev`; the full Compose stack overrides them.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devflow
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devflow_test

# ── Redis (optional — empty = in-memory fallback) ───────────────────
REDIS_URL=redis://localhost:6379

# ── GitHub sign-in (optional) ───────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Google sign-in (optional) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub App integration (optional) ───────────────────────────────
GITHUB_APP_ID=
# Path the app reads the key from. Local: ./your-app.private-key.pem
# (Docker Compose overrides this to /run/secrets/github-app.pem automatically.)
GITHUB_APP_PRIVATE_KEY_PATH=
# Docker only: the .pem file name in this folder that Compose mounts into the container.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=

# ── Email ────────────────────────────────────────────────────────────
# console = print emails to the log (default) · smtp = real delivery · resend = later, with a domain
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DevFlow <you@example.com>"
