{
  "openapi": "3.1.0",
  "info": {
    "title": "DevFlow API",
    "version": "0.1.0",
    "description": "REST API for DevFlow, a sprint-based issue tracker. Errors use RFC 9457 problem details; see docs/INTEGRATION.md for the error catalogue and integration contract."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "Liveness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "example": {
          "status": "ok"
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "`urn:devflow:error:<code>`"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "description": "The request path."
          },
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "UNAUTHENTICATED",
              "TOKEN_EXPIRED",
              "INVALID_CREDENTIALS",
              "FORBIDDEN",
              "CANNOT_CHANGE_OWN_ROLE",
              "NOT_FOUND",
              "EMAIL_TAKEN",
              "PROJECT_KEY_TAKEN",
              "SPRINT_ALREADY_ACTIVE",
              "SPRINT_NOT_PLANNED",
              "STATUS_DELETE_BLOCKED",
              "LAST_ADMIN",
              "ALREADY_MEMBER",
              "CONFLICT_STALE",
              "PAYLOAD_TOO_LARGE",
              "VALIDATION_FAILED",
              "RATE_LIMITED",
              "INTERNAL_ERROR"
            ],
            "description": "Stable machine-readable code; see docs/INTEGRATION.md."
          },
          "requestId": {
            "type": "string",
            "description": "Matches the X-Request-Id response header."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            },
            "description": "Present on 422 VALIDATION_FAILED only."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId"
        ],
        "description": "RFC 9457 problem details, served as application/problem+json.",
        "example": {
          "type": "urn:devflow:error:SPRINT_ALREADY_ACTIVE",
          "title": "Another sprint is already active",
          "status": 409,
          "detail": "Sprint 25 is already active in DEV.",
          "instance": "/api/v1/sprints/0193f1c2-8a4b-7c3d-9e5f-1a2b3c4d5e6f/start",
          "code": "SPRINT_ALREADY_ACTIVE",
          "requestId": "6f1c2a9e-3b7d-4c8e-9f0a-1b2c3d4e5f60"
        }
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              },
              "redis": {
                "type": "string",
                "enum": [
                  "up",
                  "down",
                  "disabled"
                ],
                "description": "`disabled` when REDIS_URL is not set."
              }
            },
            "required": [
              "database",
              "redis"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "example": {
          "status": "ok",
          "checks": {
            "database": "up",
            "redis": "up"
          }
        }
      },
      "PublicConfig": {
        "type": "object",
        "properties": {
          "oauth": {
            "type": "object",
            "properties": {
              "github": {
                "type": "boolean",
                "description": "Show “Continue with GitHub”."
              },
              "google": {
                "type": "boolean",
                "description": "Show “Continue with Google”."
              }
            },
            "required": [
              "github",
              "google"
            ]
          },
          "githubIntegration": {
            "type": "boolean",
            "description": "GitHub App webhooks link PRs and commits to issues."
          },
          "email": {
            "type": "boolean",
            "description": "Emails (password reset, invites) are really delivered. When false they are only written to the server log."
          }
        },
        "required": [
          "oauth",
          "githubIntegration",
          "email"
        ],
        "example": {
          "oauth": {
            "github": true,
            "google": false
          },
          "githubIntegration": false,
          "email": false
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Operational"
        ],
        "summary": "Liveness",
        "description": "Answers as long as the process is up. Used by the Docker HEALTHCHECK.",
        "responses": {
          "200": {
            "description": "The process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          },
          "default": {
            "description": "Error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Operational"
        ],
        "summary": "Readiness",
        "description": "Checks the database, and Redis when REDIS_URL is set.",
        "responses": {
          "200": {
            "description": "Ready to serve traffic.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A configured dependency is down.",
            "content": {
              "application/json": {
                "example": {
                  "status": "unavailable",
                  "checks": {
                    "database": "down",
                    "redis": "up"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "default": {
            "description": "Error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/config": {
      "get": {
        "tags": [
          "Config"
        ],
        "summary": "Enabled optional features",
        "description": "No authentication. Lets the frontend hide sign-in options and integrations that are not configured.",
        "responses": {
          "200": {
            "description": "Feature flags.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            }
          },
          "default": {
            "description": "Error, as RFC 9457 problem details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
